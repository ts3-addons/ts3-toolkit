#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "settings_resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 320, 299
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TS3Toolkit 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "启用入场音效", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 130, 14
    LTEXT "进入频道时播放，频道内其他人可以听到。", -1, 22, 26, 270, 12
    LTEXT "音效文件", -1, 12, 46, 70, 12
    EDITTEXT IDC_SOUND_PATH, 12, 62, 230, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_BROWSE, 248, 62, 60, 16
    LTEXT "支持 WAV、MP3、FLAC，源文件最长 5 分钟。", -1, 12, 82, 280, 12
    PUSHBUTTON "试听音效", IDC_PREVIEW, 12, 99, 64, 18
    PUSHBUTTON "停止试听", IDC_STOP_PREVIEW, 82, 99, 64, 18
    LTEXT "播放范围：完整音频", IDC_RANGE_SUMMARY, 12, 125, 205, 12
    PUSHBUTTON "编辑范围…", IDC_EDIT_RANGE, 232, 122, 76, 18
    LTEXT "播放设置", -1, 12, 149, 70, 12
    LTEXT "音量", -1, 12, 169, 60, 12
    CONTROL "音量", IDC_VOLUME_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 82, 166, 145, 18
    EDITTEXT IDC_VOLUME, 232, 167, 38, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "%", -1, 275, 169, 15, 12
    LTEXT "播放延迟", -1, 12, 193, 60, 12
    EDITTEXT IDC_DELAY, 82, 191, 48, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "毫秒（0–30000）", -1, 138, 193, 150, 12
    LTEXT "冷却时间", -1, 12, 217, 60, 12
    EDITTEXT IDC_COOLDOWN, 82, 215, 48, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "秒（0–300）", -1, 138, 217, 120, 12
    LTEXT "播放结束后，冷却期间不会再次触发。", -1, 82, 235, 220, 12
    CONTROL "入场时通过默认播放设备监听", IDC_MONITOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 253, 190, 14
    DEFPUSHBUTTON "保存", IDOK, 248, 271, 60, 18
    PUSHBUTTON "取消", IDCANCEL, 182, 271, 60, 18
END

IDD_RANGE DIALOGEX 0, 0, 330, 194
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑播放范围"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "输入分:秒.毫秒；播放片段最长 30 秒。", -1, 12, 10, 300, 12
    LTEXT "起点", -1, 12, 34, 35, 12
    CONTROL "起点", IDC_RANGE_START_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 52, 31, 170, 18
    EDITTEXT IDC_RANGE_START, 230, 32, 88, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "终点", -1, 12, 60, 35, 12
    CONTROL "终点", IDC_RANGE_END_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 52, 57, 170, 18
    EDITTEXT IDC_RANGE_END, 230, 58, 88, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "播放位置", -1, 12, 91, 45, 12
    CONTROL "播放位置", IDC_RANGE_POSITION, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 62, 88, 256, 18
    LTEXT "", IDC_RANGE_POSITION_TEXT, 62, 108, 230, 12
    PUSHBUTTON "试听选中片段", IDC_RANGE_PLAY, 12, 128, 86, 18
    PUSHBUTTON "停止试听", IDC_RANGE_STOP, 104, 128, 64, 18
    PUSHBUTTON "重置范围", IDC_RANGE_RESET, 174, 128, 64, 18
    PUSHBUTTON "取消", IDCANCEL, 192, 164, 60, 18
    DEFPUSHBUTTON "确定", IDOK, 258, 164, 60, 18
END
