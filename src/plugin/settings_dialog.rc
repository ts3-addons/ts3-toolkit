#pragma code_page(65001)
#include <windows.h>
#include "settings_resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 300, 196
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TS3Toolkit 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "启用入场音效", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 130, 14
    LTEXT "音效文件", -1, 12, 33, 60, 12
    EDITTEXT IDC_SOUND_PATH, 12, 47, 214, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_BROWSE, 232, 46, 56, 16
    LTEXT "音量（0–100%）", -1, 12, 71, 95, 12
    EDITTEXT IDC_VOLUME, 114, 69, 45, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "延迟（毫秒，0–30000）", -1, 12, 94, 110, 12
    EDITTEXT IDC_DELAY, 132, 92, 45, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "冷却（秒，0–300）", -1, 12, 117, 110, 12
    EDITTEXT IDC_COOLDOWN, 132, 115, 45, 14, ES_NUMBER | WS_TABSTOP
    CONTROL "通过默认播放设备监听音效", IDC_MONITOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 138, 180, 14
    LTEXT "保存后请重新启动 TeamSpeak。", -1, 12, 159, 180, 12
    DEFPUSHBUTTON "保存", IDOK, 177, 177, 52, 15
    PUSHBUTTON "取消", IDCANCEL, 236, 177, 52, 15
END
