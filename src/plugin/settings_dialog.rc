#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "settings_resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 320, 278
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TS3Toolkit 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "启用入场音效", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 130, 14
    LTEXT "进入频道时播放，频道内其他人可以听到。", -1, 22, 26, 270, 12
    LTEXT "音效文件", -1, 12, 46, 70, 12
    EDITTEXT IDC_SOUND_PATH, 12, 62, 230, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_BROWSE, 248, 62, 60, 16
    LTEXT "支持 WAV、MP3、FLAC，最长 30 秒。", -1, 12, 82, 240, 12
    PUSHBUTTON "试听音效", IDC_PREVIEW, 12, 99, 64, 18
    PUSHBUTTON "停止试听", IDC_STOP_PREVIEW, 82, 99, 64, 18
    LTEXT "播放设置", -1, 12, 128, 70, 12
    LTEXT "音量", -1, 12, 148, 60, 12
    CONTROL "音量", IDC_VOLUME_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 82, 145, 145, 18
    EDITTEXT IDC_VOLUME, 232, 146, 38, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "%", -1, 275, 148, 15, 12
    LTEXT "播放延迟", -1, 12, 172, 60, 12
    EDITTEXT IDC_DELAY, 82, 170, 48, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "毫秒（0–30000）", -1, 138, 172, 150, 12
    LTEXT "冷却时间", -1, 12, 196, 60, 12
    EDITTEXT IDC_COOLDOWN, 82, 194, 48, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "秒（0–300）", -1, 138, 196, 120, 12
    LTEXT "播放结束后，冷却期间不会再次触发。", -1, 82, 214, 220, 12
    CONTROL "入场时通过默认播放设备监听", IDC_MONITOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 232, 190, 14
    DEFPUSHBUTTON "保存", IDOK, 248, 250, 60, 18
    PUSHBUTTON "取消", IDCANCEL, 182, 250, 60, 18
END
